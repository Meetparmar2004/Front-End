3. Write a MongoDB aggregation query to calculate the total number of orders placed for each restaurant in the 'orders' collection and display the restaurant_id with its corresponding order count.

->  db.orders.aggregate([
    {
        $group: {
        _id: "$restaurant_id",
        order_count: { $sum: 1 }
        }
    }
    ])


4. Generate a report using MongoDB aggregation that finds the top 2 restaurants with the highest average order amount from your 'orders' collection.

->  db.orders.aggregate([
    {
        $group: {
        _id: "$restaurant_id",
        average_order_amount: {
            $avg: "$total_amount"
        }
        }
    },
    {
        $sort: {
        average_order_amount: -1
        }
    },
    {
        $limit: 2
    }
    ])


5. Refactor your 'orders' collection to include a 'delivery_status' field (values: 'pending', 'out for delivery', 'delivered'). Update all existing orders to randomly assign one of these statuses, then write a query to count how many orders are currently 'pending'.

->  db.orders.updateMany(
    {},
    [
        {
        $set: {
            delivery_status: {
            $switch: {
                branches: [
                {
                    case: { $lt: [{ $rand: {} }, 0.33] },
                    then: "pending"
                },
                {
                    case: { $lt: [{ $rand: {} }, 0.66] },
                    then: "out for delivery"
                }
                ],
                default: "delivered"
            }
            }
        }
        }
    ]
    )
->  db.orders.find()
->  db.orders.countDocuments({
    delivery_status: "pending"
    })