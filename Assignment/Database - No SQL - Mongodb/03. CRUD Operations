3. Write a query using find to display all products from a 'flipkart_products' collection where the price is less than 1000.

-> db.flipkart_products.insertMany([
    {
        name: "Wireless Mouse",
        brand: "Logitech",
        price: 799,
        category: "Electronics"
    },
    {
        name: "Bluetooth Speaker",
        brand: "Boat",
        price: 1499,
        category: "Electronics"
    }
])

-> db.flipkart_products.find({
    price: { $lt: 1000 }
})


4. Update the rating of a restaurant named 'Burger Hub' in the 'restaurants' collection to 4.7 using updateOne.

-> db.restaurants.updateOne(
    { name: "Burger Hub" },
    { $set: { rating: 4.7 } }
)


